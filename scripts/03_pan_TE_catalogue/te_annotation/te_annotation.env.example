# Copy this template to a private configuration file and edit the generic placeholders.
# Use one configuration file per assembly; reuse the same scripts for every assembly.
# Do not commit real sample identifiers, private server paths, or local credentials.

GENOME_ID="genome_01"
GENOME_FASTA="/path/to/genome.fa"
WORK_DIR="/path/to/TE_annotation/$GENOME_ID"
THREADS=36

# RepeatModeler2 output: set this after the RepeatModeler2 run has completed.
RM2_CLASSIFIED_FASTA="/path/to/01_repeatmodeler2/RM_xxxxx/consensi.fa.classified"

# TEtrimmer
TETRIMMER_PY="/path/to/TEtrimmer/TEtrimmer.py"
TETRIMMER_INPUT_FASTA="$RM2_CLASSIFIED_FASTA"
TETRIMMER_OUTPUT_DIR="$WORK_DIR/02_tetrimmer"
PFAM_DIR="/path/to/Pfam"

# MCHelper
MCHELPER_PY="/path/to/MCHelper.py"
MCHELPER_INPUT_FASTA="/path/to/TEtrimmer_curated_consensus.fa"
MCHELPER_OUTPUT_DIR="$WORK_DIR/03_mchelper"
MCHELPER_THREADS=24
BUSCO_HMM="/path/to/actinopterygii_odb10.all.hmm"

# LTR structural annotation
LTR_FINDER_PARALLEL="/path/to/LTR_FINDER_parallel"
GENOMETOOLS_GT="/path/to/gt"
LTR_RETRIEVER="/path/to/LTR_retriever"

# Class II structural annotation
MITE_HUNTER_MANAGER="/path/to/MITE-Hunter/MITE_Hunter_manager.pl"
HELITRONSCANNER_TRAINING_DIR="/path/to/HelitronScanner/TrainingSet"
MITE_FASTA="$WORK_DIR/05_mite_hunter/MITE_P1_Step7.fa"
HELITRON_FASTA="$WORK_DIR/06_helitronscanner/HelitronScanner.all.fa"

# TEsorter and homology evidence
TE_SORTER_INPUT_FASTA="$RM2_CLASSIFIED_FASTA"
HOMOLOGY_QUERY_FASTA="/path/to/unresolved_consensus.fa"

# RepBase 31.07 nucleotide BLAST database (pre-built).
REPBASE_DB_PREFIX="/path/to/RepBase31.07_fish_vertebrate.clean"

# Dfam reference FASTAs supplied to the database-build step.
# Level 1: Xenocyprididae; level 2: Cypriniformes.
# The exact release/export provenance of the final study references must be recorded separately.
DFAM_REFERENCE_FASTA_1="/path/to/Dfam_Xenocyprididae_curated.TE.fa"
DFAM_REFERENCE_FASTA_2="/path/to/Dfam_Cypriniformes_curated.TE.fa"
DFAM_DB_PREFIX_1="/path/to/shared_reference_db/Dfam_Xenocyprididae"
DFAM_DB_PREFIX_2="/path/to/shared_reference_db/Dfam_Cypriniformes"

# Optional: set only after level-1 Unknown rescue/integration has produced
# the FASTA of sequences that remain unresolved.
DFAM_LEVEL2_QUERY_FASTA=""

# RepeatMasker: use the genome-specific curated library for primary annotation,
# or the unified library for cross-assembly sensitivity analysis.
REPEATMASKER_LIBRARY_FASTA="/path/to/curated_repeat_library.fa"
REPEATMASKER_OUT_DIR="$WORK_DIR/12_repeatmasker"
